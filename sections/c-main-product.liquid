}
</style>

<script>
(function () {
  var pdp = document.getElementById('c-pdp-{{ section.id }}');
  if (!pdp) return;
  function updatePdpTop() {
  var announcementH = parseFloat(
    getComputedStyle(document.documentElement)
      .getPropertyValue('--announcement-bar-height')
  ) || 0;
  var header = document.getElementById('c-header');
  var headerH = header ? header.getBoundingClientRect().height : 0;
  var totalH = announcementH + headerH;
  pdp.style.setProperty('--pdp-header-h', totalH + 'px');
}
// DOM ready hone ke baad run karo
setTimeout(updatePdpTop, 100);
window.addEventListener('resize', updatePdpTop);
/* ── Thumbnail gallery ── */
var thumbs    = pdp.querySelectorAll('.c-pdp__thumb');
var mainImg   = document.getElementById('c-pdp-main-img-{{ section.id }}');
var mainVideo = document.getElementById('c-pdp-main-video-{{ section.id }}');

function showMedia(type, src, alt, videoSrc) {
  if (type === 'video' && mainVideo) {
    mainImg.style.opacity = '0';
    setTimeout(function () {
      mainImg.style.display = 'none';
      mainVideo.style.display = 'block';
      mainVideo.style.opacity = '0';
      mainVideo.src = videoSrc;
      mainVideo.load();
      mainVideo.play();
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          mainVideo.style.transition = 'opacity 0.25s ease';
          mainVideo.style.opacity = '1';
        });
      });
    }, 250);
  } else {
    // Video band karo
    if (mainVideo && mainVideo.style.display !== 'none') {
      mainVideo.pause();
      mainVideo.style.transition = 'none';
      mainVideo.style.opacity = '0';
      mainVideo.style.display = 'none';
      mainVideo.removeAttribute('src');
    }
    // Image show karo
    mainImg.src = src;
    mainImg.alt = alt || '';
    mainImg.style.transition = 'none';
    mainImg.style.opacity = '0';
    mainImg.style.display = 'block';
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        mainImg.style.transition = 'opacity 0.25s ease';
        mainImg.style.opacity = '1';
      });
    });
  }
}

thumbs.forEach(function (thumb) {
  thumb.addEventListener('click', function () {
    showMedia(
      thumb.dataset.mediaType,
      thumb.dataset.imageSrc,
      thumb.dataset.imageAlt,
      thumb.dataset.videoUrl
    );
    thumbs.forEach(function (t) {
      t.classList.remove('is-active');
      t.setAttribute('aria-pressed', 'false');
    });
    thumb.classList.add('is-active');
    thumb.setAttribute('aria-pressed', 'true');
  });
});
  /* ── Accordion ── */
  var triggers = pdp.querySelectorAll('.c-pdp__accordion-trigger');
  triggers.forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var body   = trigger.nextElementSibling;
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';
      triggers.forEach(function (t) {
        t.setAttribute('aria-expanded', 'false');
        if (t.nextElementSibling) t.nextElementSibling.hidden = true;
      });
      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        if (body) body.hidden = false;
      }
    });
  });

  /* ── Variant selector ── */
  var optionBtns   = pdp.querySelectorAll('.c-pdp__option-btn');
  var variantInput = document.getElementById('c-pdp-variant-id-{{ section.id }}');
  var atcBtn       = document.getElementById('c-pdp-atc-{{ section.id }}');
  var priceEl      = document.getElementById('c-pdp-price-{{ section.id }}');
  var variants     = {{ product.variants | json }};

  function formatMoney(cents) {
   var amount = cents / 100;
return '$' + (amount % 1 === 0 ? amount.toFixed(0) : amount.toFixed(2));
  }

  function getSelected() {
    var sel = {};
    optionBtns.forEach(function (b) {
      if (b.classList.contains('is-active')) sel[b.dataset.optionPosition] = b.dataset.optionValue;
    });
    return sel;
  }

  function findVariant(sel) {
    return variants.find(function (v) {
      return v.options.every(function (opt, i) {
        return sel[String(i + 1)] === opt;
      });
    });
  }

  optionBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      pdp.querySelectorAll('[data-option-position="' + btn.dataset.optionPosition + '"]').forEach(function (b) {
        b.classList.remove('is-active');
      });
      btn.classList.add('is-active');

      var variant = findVariant(getSelected());
      if (!variant) return;

      if (variantInput) variantInput.value = variant.id;
      if (priceEl) priceEl.textContent = formatMoney(variant.price);

     if (atcBtn) {
  var label = atcBtn.querySelector('.c-pdp__atc-text');

  if (variant.available) {
    atcBtn.disabled = false;
    atcBtn.type = 'submit';
    atcBtn.dataset.notify = 'false';
    atcBtn.classList.remove('is-notify');

    if (label) {
      label.textContent = '{{ section.settings.atc_text | default: "Add to Cart" }}';
    }

  } else {
    atcBtn.disabled = false;
    atcBtn.type = 'button';
    atcBtn.dataset.notify = 'true';
    atcBtn.classList.add('is-notify');

    if (label) {
      label.textContent = '{{ section.settings.notify_me_text | default: "Notify Me" }}';
    }
  }
}

      if (variant.featured_image && mainImg) {
        mainImg.style.opacity = '0';
        setTimeout(function () {
          mainImg.src = variant.featured_image.src;
          mainImg.style.opacity = '1';
        }, 200);
      }
    });
  });
  /* ── Back In Stock ── */

var bisModal = document.getElementById('c-bis-modal-{{ section.id }}');
var bisForm = document.getElementById('c-bis-form-{{ section.id }}');
var bisEmail = document.getElementById('c-bis-email-{{ section.id }}');
var bisSubmit = document.getElementById('c-bis-submit-{{ section.id }}');
var bisMessage = document.getElementById('c-bis-message-{{ section.id }}');

var bisVariant = {{ current_variant.id | json }};
var bisVariantTitle = {{ current_variant.title | json }};

var klaviyoPublicKey = '{{ section.settings.klaviyo_public_api_key | escape }}';

function openBisModal() {
  if (!bisModal) return;

  bisModal.classList.add('is-visible');
  bisModal.setAttribute('aria-hidden', 'false');

  setTimeout(function () {
    if (bisEmail) bisEmail.focus();
  }, 100);
}

function closeBisModal() {
  if (!bisModal) return;

  bisModal.classList.remove('is-visible');
  bisModal.setAttribute('aria-hidden', 'true');

  if (bisMessage) {
    bisMessage.textContent = '';
  }
}

if (atcBtn) {
  atcBtn.addEventListener('click', function (event) {

    if (atcBtn.dataset.notify !== 'true') {
      return;
    }

    event.preventDefault();
    event.stopPropagation();

    bisVariant = variantInput
      ? variantInput.value
      : bisVariant;

    var selectedVariant = variants.find(function (v) {
      return String(v.id) === String(bisVariant);
    });

    if (selectedVariant) {
      bisVariantTitle = selectedVariant.title;
    }

    openBisModal();
  });
}

/* Close modal */

if (bisModal) {
  bisModal.querySelectorAll('[data-bis-close]').forEach(function (element) {
    element.addEventListener('click', closeBisModal);
  });
}

/* Escape key */

document.addEventListener('keydown', function (event) {
  if (event.key === 'Escape' && bisModal && bisModal.classList.contains('is-visible')) {
    closeBisModal();
  }
});

/* Submit Back In Stock subscription */

if (bisForm) {

  bisForm.addEventListener('submit', function (event) {

    event.preventDefault();

    var email = bisEmail ? bisEmail.value.trim() : '';

    if (!email || !email.includes('@')) {
      if (bisMessage) {
        bisMessage.textContent = 'Please enter a valid email address.';
      }
      return;
    }

    if (!klaviyoPublicKey) {
      console.error('Klaviyo Public API Key is missing.');

      if (bisMessage) {
        bisMessage.textContent = 'Something went wrong. Please try again.';
      }

      return;
    }

    if (bisSubmit) {
      bisSubmit.disabled = true;
      bisSubmit.textContent = 'Submitting...';
    }

    if (bisMessage) {
      bisMessage.textContent = '';
    }

    var catalogVariantId =
      '$shopify:::$default:::' + String(bisVariant);

    var payload = {
      data: {
        type: 'back-in-stock-subscription',
        attributes: {
          profile: {
            data: {
              type: 'profile',
              attributes: {
                email: email
              }
            }
          },
          channels: ['EMAIL']
        },
        relationships: {
          variant: {
            data: {
              type: 'catalog-variant',
              id: catalogVariantId
            }
          }
        }
      }
    };

    fetch(
      'https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' +
      encodeURIComponent(klaviyoPublicKey),
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'revision': '2024-06-15'
        },
        body: JSON.stringify(payload)
      }
    )
    .then(function (response) {

      if (!response.ok) {
        throw new Error('Klaviyo subscription failed');
      }

      return response;
    })
    .then(function () {

      if (bisMessage) {
        bisMessage.textContent =
          'You’re on the list. We’ll email you when it’s back in stock.';
      }

      if (bisEmail) {
        bisEmail.value = '';
      }

      if (bisSubmit) {
        bisSubmit.textContent = 'You’re on the list';
      }

      setTimeout(function () {
        closeBisModal();

        if (bisSubmit) {
          bisSubmit.disabled = false;
          bisSubmit.textContent = 'Notify Me';
        }
      }, 2500);

    })
    .catch(function (error) {

      console.error('Back in Stock error:', error);

      if (bisMessage) {
        bisMessage.textContent =
          'Something went wrong. Please try again.';
      }

      if (bisSubmit) {
        bisSubmit.disabled = false;
        bisSubmit.textContent = 'Notify Me';
      }
    });

  });
}
var trioBtn = document.getElementById('trio-coming-soon-btn');

if (trioBtn) {

  trioBtn.addEventListener('click', function () {

    var overlay = document.getElementById('cast-trio-popup-overlay');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

  });

}
})();
</script>
