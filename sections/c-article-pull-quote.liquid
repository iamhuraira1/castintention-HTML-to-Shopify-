{% comment %}
  CAST — Journal Pull Quote
  File: sections/c-article-pull-quote.liquid

  Features:
  - Full-width centered pull quote
  - Text editable via section settings
  - Reusable: works on article.liquid and about page
  - Top + bottom borders
  - Max width constrained, centered
  - No JS
{% endcomment %}

{% if section.settings.quote != blank %}
<div
  class="c-article-pull-quote"
  id="c-article-pull-quote-{{ section.id }}"
>
  <div class="c-article-pull-quote__inner">
    <p class="c-article-pull-quote__text">{{ section.settings.quote }}</p>
  </div>
</div>
{% endif %}

<style>
  #c-article-pull-quote-{{ section.id }} {
    --apq-bg:   {{ section.settings.bg_color }};
    --apq-text: {{ section.settings.text_color }};
  }

  .c-article-pull-quote {
    background: var(--apq-bg);
    border-top: 1.5px solid rgba(0,0,0,0.14);
    border-bottom: 1.5px solid rgba(0,0,0,0.14);
  }

  .c-article-pull-quote__inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 72px 40px;
  }

  .c-article-pull-quote__text {
    font-family: 'Spectral', Georgia, serif;
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 300;
    line-height: 1.4;
    color: var(--apq-text);
    letter-spacing: -0.01em;
  }

  @media screen and (max-width: 640px) {
    .c-article-pull-quote__inner {
      padding: 48px 24px;
    }

    .c-article-pull-quote__text {
      font-size: clamp(20px, 5.5vw, 28px);
    }
  }
</style>

{% schema %}
{
  "name": "Article Pull Quote",
  "tag": "div",
  "class": "c-article-pull-quote-wrapper",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote text",
      "default": "The body is not being sedated. It is being cued. Sedation bypasses the nervous system's own capacity. A cue works with it."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F9F8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Article Pull Quote",
      "settings": {
        "quote": "The body is not being sedated. It is being cued. Sedation bypasses the nervous system's own capacity. A cue works with it."
      }
    }
  ]
}
{% endschema %}
