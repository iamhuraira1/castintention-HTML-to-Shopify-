{% assign all_reviews = shop.metaobjects.cast_review.values %}
{% assign review_count = 0 %}

<section
  class="c-all-reviews"
  id="c-all-reviews-{{ section.id }}"
  data-per-page="3"
>
  <div class="c-all-reviews__inner">

    {% if section.settings.heading != blank %}
      <div class="c-all-reviews__header">
        <h1 class="c-all-reviews__heading">
          {{ section.settings.heading }}
        </h1>

        {% if section.settings.subheading != blank %}
          <p class="c-all-reviews__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="c-all-reviews__grid"
      id="c-all-reviews-grid-{{ section.id }}"
    >
      {% for review in all_reviews %}

        {% if review.approved.value == true %}

          {% assign review_count = review_count | plus: 1 %}

          <article
            class="c-all-reviews__card"
            data-review-card
          >

            {%- comment -%}
              Stars
            {%- endcomment -%}

            <div
              class="c-all-reviews__stars"
              aria-label="{{ review.rating.value }} out of 5 stars"
            >
              {% for i in (1..5) %}
                <span
                  class="c-all-reviews__star{% if i > review.rating.value %} is-empty{% endif %}"
                  aria-hidden="true"
                ></span>
              {% endfor %}
            </div>

            {%- comment -%}
              Review text
            {%- endcomment -%}

            {% if review.review_text.value != blank %}
              <p class="c-all-reviews__text">
                {{ review.review_text.value }}
              </p>
            {% endif %}

            {%- comment -%}
              Reviewer meta
            {%- endcomment -%}

            <div class="c-all-reviews__meta">

              {% if review.reviewer_name.value != blank %}
                <span class="c-all-reviews__name">
                  {{ review.reviewer_name.value }}
                </span>
              {% endif %}

              {% if review.reviewer_location_date.value != blank %}
                <span class="c-all-reviews__date">
                  {{ review.reviewer_location_date.value }}
                </span>
              {% endif %}

            </div>

          </article>

        {% endif %}

      {% endfor %}
    </div>

    {% if review_count == 0 %}
      <p class="c-all-reviews__empty">
        No reviews yet. Be the first to write one.
      </p>
    {% endif %}

    {% if review_count > 12 %}
      <div
        class="c-all-reviews__pagination"
        id="c-all-reviews-pagination-{{ section.id }}"
      >
        <button
          type="button"
          class="c-all-reviews__page-btn"
          data-page-prev
          aria-label="Previous reviews"
        >
          ←
        </button>

        <span
          class="c-all-reviews__page-status"
          data-page-status
        ></span>

        <button
          type="button"
          class="c-all-reviews__page-btn"
          data-page-next
          aria-label="Next reviews"
        >
          →
        </button>
      </div>
    {% endif %}

    <div class="c-all-reviews__cta">

      <button
        type="button"
        class="c-all-reviews__cta-btn c-all-reviews__write-btn"
        data-write-review-open
      >
        {{ section.settings.write_review_text | default: "Write a Review" }}
      </button>

    </div>

  </div>
</section>


{%- comment -%}
  ============================================================
  WRITE A REVIEW MODAL
  Same behavior/design as PDP Reviews section
  ============================================================
{%- endcomment -%}

<div
  class="c-write-review__overlay"
  data-write-review-modal
  hidden
>
  <div
    class="c-write-review__box"
    role="dialog"
    aria-modal="true"
    aria-labelledby="c-write-review-title-{{ section.id }}"
  >

    <button
      type="button"
      class="c-write-review__close"
      data-write-review-close
      aria-label="Close"
    >
      ×
    </button>

    <h3
      class="c-write-review__title"
      id="c-write-review-title-{{ section.id }}"
    >
      Write a Review
    </h3>

    {% form 'contact', id: 'c-write-review-form' %}

      {% if form.posted_successfully? %}

        <p class="c-write-review__success">
          Thank you — your review has been submitted for approval.
        </p>

      {% else %}

        <input
          type="hidden"
          name="contact[Subject]"
          value="New Product Review"
        >

        <label
          class="c-write-review__label"
          for="cwr-rating-{{ section.id }}"
        >
          Rating
        </label>

        <select
          class="c-write-review__input"
          id="cwr-rating-{{ section.id }}"
          name="contact[Rating]"
          required
        >
          <option value="">Select a rating</option>
          <option value="5">5 - Excellent</option>
          <option value="4">4 - Good</option>
          <option value="3">3 - Average</option>
          <option value="2">2 - Poor</option>
          <option value="1">1 - Very poor</option>
        </select>


        <label
          class="c-write-review__label"
          for="cwr-name-{{ section.id }}"
        >
          Name
        </label>

        <input
          class="c-write-review__input"
          type="text"
          id="cwr-name-{{ section.id }}"
          name="contact[Name]"
          required
        >


        <label
          class="c-write-review__label"
          for="cwr-email-{{ section.id }}"
        >
          Email
        </label>

        <input
          class="c-write-review__input"
          type="email"
          id="cwr-email-{{ section.id }}"
          name="contact[email]"
          required
        >


        <label
          class="c-write-review__label"
          for="cwr-location-{{ section.id }}"
        >
          Location (optional)
        </label>

        <input
          class="c-write-review__input"
          type="text"
          id="cwr-location-{{ section.id }}"
          name="contact[Location]"
          placeholder="e.g. Toronto, ON"
        >


        <label
          class="c-write-review__label"
          for="cwr-body-{{ section.id }}"
        >
          Your review
        </label>

        <textarea
          class="c-write-review__input c-write-review__textarea"
          id="cwr-body-{{ section.id }}"
          name="contact[body]"
          rows="5"
          required
        ></textarea>


        <button
          type="submit"
          class="c-write-review__submit"
        >
          Submit Review
        </button>

        <p class="c-write-review__note">
          Reviews are checked before they're published.
        </p>

      {% endif %}

    {% endform %}

  </div>
</div>


<style>

  #c-all-reviews-{{ section.id }} {

    --rev-bg:             {{ section.settings.bg_color }};
    --rev-card-bg:        {{ section.settings.card_bg_color }};
    --rev-text:           {{ section.settings.text_color }};
    --rev-muted:          {{ section.settings.muted_color }};
    --rev-star:           {{ section.settings.star_color }};

    --rev-padding-desktop: {{ section.settings.padding_desktop }}px;
    --rev-padding-tablet:  {{ section.settings.padding_tablet }}px;
    --rev-padding-mobile:  {{ section.settings.padding_mobile }}px;

  }


  /* ============================================================
     SECTION
     ============================================================ */

  .c-all-reviews {

    padding:
      var(--rev-padding-desktop)
      80px;

    background: var(--rev-bg);

    {% if section.settings.show_border_top %}
      border-top: 1.5px solid rgba(0,0,0,0.14);
    {% endif %}

    font-family: 'Work Sans', sans-serif;

  }


  .c-all-reviews__inner {

    width: 100%;
    max-width: 1400px;
    margin: 0 auto;

  }


  /* ============================================================
     HEADER
     ============================================================ */

  .c-all-reviews__header {

    text-align: center;

    max-width: 700px;

    margin:
      0 auto
      64px;

  }


  .c-all-reviews__heading {

    margin: 0;

    font-family:
      'Spectral',
      Georgia,
      serif;

    font-size: 36px;

    line-height: 1.2;

    font-weight: 400;

    color: var(--rev-text);

  }


  .c-all-reviews__subheading {

    margin:
      16px
      0
      0;

    font-family:
      'Work Sans',
      sans-serif;

    font-size: 13px;

    line-height: 1.7;

    font-weight: 300;

    color: var(--rev-muted);

  }


  /* ============================================================
     GRID
     ============================================================ */

  .c-all-reviews__grid {

    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 20px;

    margin-bottom: 32px;

  }


  /* ============================================================
     CARD
     ============================================================ */

  .c-all-reviews__card {

    background:
      var(--rev-card-bg);

    padding:
      36px
      32px
      40px;

    display: flex;

    flex-direction: column;

    gap: 16px;

    border:
      1px solid
      rgba(0,0,0,0.1);

  }


  .c-all-reviews__card[data-hidden] {

    display: none;

  }


  /* ============================================================
     STARS
     ============================================================ */

  .c-all-reviews__stars {

    display: flex;

    gap: 4px;

  }


  .c-all-reviews__star {

    width: 10px;

    height: 10px;

    background:
      var(--rev-star);

    clip-path:
      polygon(
        50% 0%,
        61% 35%,
        98% 35%,
        68% 57%,
        79% 91%,
        50% 70%,
        21% 91%,
        32% 57%,
        2% 35%,
        39% 35%
      );

    display: inline-block;

    flex-shrink: 0;

  }


  .c-all-reviews__star.is-empty {

    background:
      rgba(0,0,0,0.15);

  }


  /* ============================================================
     REVIEW TEXT
     ============================================================ */

  .c-all-reviews__text {

    font-family:
      'Spectral',
      Georgia,
      serif;

    font-size: 15px;

    line-height: 1.75;

    color: var(--rev-text);

    font-weight: 300;

    flex: 1;

    margin: 0;

  }


  /* ============================================================
     META
     ============================================================ */

  .c-all-reviews__meta {

    display: flex;

    flex-direction: column;

    gap: 4px;

    padding-top: 16px;

    border-top:
      1px solid
      rgba(0,0,0,0.07);

  }


  .c-all-reviews__name {

    font-size: 11px;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--rev-text);

    font-weight: 300;

  }


  .c-all-reviews__date {

    font-size: 11px;

    color: var(--rev-muted);

    font-weight: 300;

    letter-spacing: 0.04em;

  }


  /* ============================================================
     EMPTY STATE
     ============================================================ */

  .c-all-reviews__empty {

    text-align: center;

    font-size: 13px;

    color: var(--rev-muted);

    margin-bottom: 32px;

  }


  /* ============================================================
     PAGINATION
     ============================================================ */

  .c-all-reviews__pagination {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 20px;

    margin-bottom: 40px;

  }


  .c-all-reviews__page-btn {

    background: transparent;

    border:
      1px solid
      rgba(0,0,0,0.25);

    width: 32px;

    height: 32px;

    cursor: pointer;

    font-size: 14px;

    color: var(--rev-text);

    transition:
      border-color 0.2s ease,
      background 0.2s ease;

  }


  .c-all-reviews__page-btn:hover:not(:disabled) {

    border-color:
      var(--rev-text);

    background:
      rgba(0,0,0,0.03);

  }


  .c-all-reviews__page-btn:disabled {

    opacity: 0.3;

    cursor: default;

  }


  .c-all-reviews__page-status {

    font-size: 11px;

    letter-spacing: 0.08em;

    color: var(--rev-muted);

    text-transform: uppercase;

  }


  /* ============================================================
     CTA
     ============================================================ */

  .c-all-reviews__cta {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 16px;

    flex-wrap: wrap;

  }


  .c-all-reviews__cta-btn {

    display: inline-block;

    padding:
      14px
      40px;

    background: transparent;

    color: var(--rev-text);

    font-family:
      'Work Sans',
      sans-serif;

    font-weight: 300;

    font-size: 11px;

    letter-spacing: 0.14em;

    text-transform: uppercase;

    text-decoration: none;

    border:
      1px solid
      rgba(0,0,0,0.25);

    cursor: pointer;

    transition:
      border-color 0.2s ease,
      background 0.2s ease;

  }


  .c-all-reviews__cta-btn:hover {

    border-color:
      var(--rev-text);

    background:
      rgba(0,0,0,0.03);

  }


  /* ============================================================
     TABLET
     ============================================================ */

  @media screen and (max-width: 900px) {

    .c-all-reviews {

      padding:
        var(--rev-padding-tablet)
        48px;

    }

    .c-all-reviews__grid {

      grid-template-columns:
        repeat(2, 1fr);

    }

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 640px) {

    .c-all-reviews {

      padding:
        var(--rev-padding-mobile)
        24px;

    }

    .c-all-reviews__header {

      margin-bottom: 40px;

    }

    .c-all-reviews__heading {

      font-size: 28px;

    }

    .c-all-reviews__grid {

      grid-template-columns: 1fr;

      gap: 16px;

    }

    .c-all-reviews__card {

      padding:
        24px
        20px
        28px;

    }

    .c-all-reviews__cta {

      flex-direction: column;

    }

  }


  /* ============================================================
     WRITE REVIEW MODAL
     ============================================================ */

  .c-write-review__overlay {

    position: fixed;

    inset: 0;

    background:
      rgba(0,0,0,0.5);

    display: flex;

    align-items: center;

    justify-content: center;

    z-index: 999;

    padding: 20px;

  }


  .c-write-review__overlay[hidden] {

    display: none;

  }


  .c-write-review__box {

    position: relative;

    background: #F9F8F6;

    max-width: 460px;

    width: 100%;

    max-height: 90vh;

    overflow-y: auto;

    padding: 40px 32px;

    font-family:
      'Work Sans',
      sans-serif;

  }


  .c-write-review__close {

    position: absolute;

    top: 16px;

    right: 16px;

    background: none;

    border: none;

    font-size: 22px;

    line-height: 1;

    cursor: pointer;

    color: #1a1a1a;

  }


  .c-write-review__title {

    font-family:
      'Spectral',
      Georgia,
      serif;

    font-weight: 400;

    font-size: 20px;

    margin:
      0 0 24px;

    color: #1a1a1a;

  }


  .c-write-review__label {

    display: block;

    font-size: 11px;

    letter-spacing: 0.1em;

    text-transform: uppercase;

    color: #1a1a1a;

    margin:
      16px
      0
      6px;

  }


  .c-write-review__input {

    width: 100%;

    padding:
      10px
      12px;

    border:
      1px solid
      rgba(0,0,0,0.2);

    background: #fff;

    font-family:
      'Work Sans',
      sans-serif;

    font-size: 14px;

    color: #1a1a1a;

    box-sizing: border-box;

  }


  .c-write-review__textarea {

    resize: vertical;

  }


  .c-write-review__submit {

    margin-top: 24px;

    width: 100%;

    padding: 14px;

    background: #1a1a1a;

    color: #fff;

    border: none;

    font-size: 11px;

    letter-spacing: 0.14em;

    text-transform: uppercase;

    cursor: pointer;

  }


  .c-write-review__note {

    margin-top: 10px;

    font-size: 11px;

    color: #666;

    text-align: center;

  }


  .c-write-review__success {

    font-size: 14px;

    color: #1a1a1a;

  }

</style>


<script>
  (function () {

    var sectionId =
      {{ section.id | json }};

    var perPage = 12;

    var grid =
      document.getElementById(
        'c-all-reviews-grid-' + sectionId
      );

    var paginationEl =
      document.getElementById(
        'c-all-reviews-pagination-' + sectionId
      );

    if (!grid) return;


    /* ==========================================================
       PAGINATION
       ========================================================== */

    var cards =
      Array.prototype.slice.call(
        grid.querySelectorAll('[data-review-card]')
      );

    var totalPages =
      Math.ceil(cards.length / perPage);

    var currentPage = 1;


    function renderPage() {

      cards.forEach(function (card, i) {

        var pageOfCard =
          Math.floor(i / perPage) + 1;

        if (pageOfCard === currentPage) {

          card.removeAttribute('data-hidden');

        } else {

          card.setAttribute(
            'data-hidden',
            ''
          );

        }

      });


      if (paginationEl) {

        var statusEl =
          paginationEl.querySelector(
            '[data-page-status]'
          );

        var prevBtn =
          paginationEl.querySelector(
            '[data-page-prev]'
          );

        var nextBtn =
          paginationEl.querySelector(
            '[data-page-next]'
          );


        if (statusEl) {

          statusEl.textContent =
            currentPage +
            ' / ' +
            totalPages;

        }


        if (prevBtn) {

          prevBtn.disabled =
            currentPage === 1;

        }


        if (nextBtn) {

          nextBtn.disabled =
            currentPage === totalPages;

        }

      }

    }


    if (paginationEl) {

      var prevBtn =
        paginationEl.querySelector(
          '[data-page-prev]'
        );

      var nextBtn =
        paginationEl.querySelector(
          '[data-page-next]'
        );


      if (prevBtn) {

        prevBtn.addEventListener(
          'click',
          function () {

            if (currentPage > 1) {

              currentPage--;

              renderPage();

              window.scrollTo({
                top:
                  grid.getBoundingClientRect().top +
                  window.scrollY -
                  100,
                behavior: 'smooth'
              });

            }

          }
        );

      }


      if (nextBtn) {

        nextBtn.addEventListener(
          'click',
          function () {

            if (currentPage < totalPages) {

              currentPage++;

              renderPage();

              window.scrollTo({
                top:
                  grid.getBoundingClientRect().top +
                  window.scrollY -
                  100,
                behavior: 'smooth'
              });

            }

          }
        );

      }

    }


    renderPage();


    /* ==========================================================
       WRITE REVIEW MODAL
       ========================================================== */

    var modal =
      document.querySelector(
        '[data-write-review-modal]'
      );

    var openBtns =
      document.querySelectorAll(
        '[data-write-review-open]'
      );

    var closeBtn =
      document.querySelector(
        '[data-write-review-close]'
      );


    openBtns.forEach(function (btn) {

      btn.addEventListener(
        'click',
        function () {

          if (modal) {

            modal.hidden = false;

            document.body.style.overflow =
              'hidden';

          }

        }
      );

    });


    if (closeBtn) {

      closeBtn.addEventListener(
        'click',
        function () {

          if (modal) {

            modal.hidden = true;

            document.body.style.overflow =
              '';

          }

        }
      );

    }


    if (modal) {

      modal.addEventListener(
        'click',
        function (e) {

          if (e.target === modal) {

            modal.hidden = true;

            document.body.style.overflow =
              '';

          }

        }
      );

    }


    /* ESC closes modal */

    document.addEventListener(
      'keydown',
      function (e) {

        if (
          e.key === 'Escape' &&
          modal &&
          !modal.hidden
        ) {

          modal.hidden = true;

          document.body.style.overflow =
            '';

        }

      }
    );


    /* ==========================================================
       AUTO OPEN AFTER SUCCESS
       ========================================================== */

    {% if form and form.posted_successfully? %}

      if (modal) {

        modal.hidden = false;

        document.body.style.overflow =
          'hidden';

      }

    {% endif %}

  })();
</script>


