{% comment %}
  ────────────────────────────────────────────────
  CAST — Policy Page (c-policy-page)
  Simple, reusable bilingual (EN/FR) legal/policy page section.
  Use for: Privacy Policy, Terms of Service, Shipping Policy,
  Return Policy, Cookie Policy, Accessibility Statement, or any
  other legal document.

  Structure:
   • One "intro" block (title, effective date, intro text)
   • Unlimited "section" blocks (numbered/unnumbered sections)
   Each block carries BOTH English and French content side by side,
   toggled instantly via the language switcher — no page reload.

  Features (kept intentionally minimal):
   • Instant EN/FR toggle, deep-linkable via ?lang=, remembered for
     the browsing session (sessionStorage), full keyboard support
   • Auto-hides the switcher if no block has French content filled in
   • Single-column, full-width reading layout on every screen size —
     no sidebar, no sticky elements, no scroll effects
   • Fully theme-integrated: color scheme picker, CAST typography
  ────────────────────────────────────────────────
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign intro_block = null
  assign section_blocks = section.blocks | where: 'type', 'section'

  for block in section.blocks
    if block.type == 'intro'
      assign intro_block = block
    endif
  endfor

  assign has_french = false
  for block in section_blocks
    if block.settings.heading_fr != blank or block.settings.content_fr != blank
      assign has_french = true
    endif
  endfor
  if intro_block and intro_block.settings.title_fr != blank
    assign has_french = true
  endif

  assign show_switcher = false
  if section.settings.show_language_switcher and has_french
    assign show_switcher = true
  endif
-%}

<section
  class="c-policy color-{{ section.settings.color_scheme }}"
  id="c-policy-{{ sid }}"
  data-default-lang="{{ section.settings.default_language }}"
  data-has-french="{{ has_french }}"
>

  <div class="c-policy__inner{% if section.settings.layout_width == 'contained' %} c-policy__inner--contained{% endif %}">

    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="c-policy__header">

      {%- if intro_block -%}
        {%- if intro_block.settings.title_en != blank -%}
          <h1 class="c-policy__title" data-lang="en">{{ intro_block.settings.title_en | escape }}</h1>
        {%- endif -%}
        {%- if intro_block.settings.title_fr != blank -%}
          <h1 class="c-policy__title" data-lang="fr">{{ intro_block.settings.title_fr | escape }}</h1>
        {%- endif -%}

        {%- if intro_block.settings.effective_date_en != blank -%}
          <p class="c-policy__date" data-lang="en">{{ intro_block.settings.effective_date_en | escape }}</p>
        {%- endif -%}
        {%- if intro_block.settings.effective_date_fr != blank -%}
          <p class="c-policy__date" data-lang="fr">{{ intro_block.settings.effective_date_fr | escape }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if show_switcher -%}
        <div class="c-policy__lang-switch" role="group" aria-label="Language / Langue">
          <button type="button" class="c-policy__lang-btn" data-lang-btn="en" aria-pressed="false">English</button>
          <button type="button" class="c-policy__lang-btn" data-lang-btn="fr" aria-pressed="false">Français</button>
        </div>
      {%- endif -%}

      {%- if intro_block and intro_block.settings.intro_en != blank -%}
        <div class="c-policy__intro" data-lang="en">{{ intro_block.settings.intro_en }}</div>
      {%- endif -%}
      {%- if intro_block and intro_block.settings.intro_fr != blank -%}
        <div class="c-policy__intro" data-lang="fr">{{ intro_block.settings.intro_fr }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Content: simple single column, full width ── {%- endcomment -%}
    <div class="c-policy__content">
      {%- for block in section_blocks -%}
        <div class="c-policy__section">

          {%- if block.settings.heading_en != blank -%}
            <h2 class="c-policy__heading" data-lang="en">{{ block.settings.heading_en | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.heading_fr != blank -%}
            <h2 class="c-policy__heading" data-lang="fr">{{ block.settings.heading_fr | escape }}</h2>
          {%- endif -%}

          {%- if block.settings.content_en != blank -%}
            <div class="c-policy__rte" data-lang="en">{{ block.settings.content_en }}</div>
          {%- endif -%}
          {%- if block.settings.content_fr != blank -%}
            <div class="c-policy__rte" data-lang="fr">{{ block.settings.content_fr }}</div>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>

</section>

<style>
  #c-policy-{{ sid }} {
    --cp-pad-top-d:     {{ section.settings.padding_top_desktop }}px;
    --cp-pad-bottom-d:  {{ section.settings.padding_bottom_desktop }}px;
    --cp-pad-top-m:     {{ section.settings.padding_top_mobile }}px;
    --cp-pad-bottom-m:  {{ section.settings.padding_bottom_mobile }}px;
    --cp-max-width:     {{ section.settings.content_max_width }}px;
    --cp-heading-space: {{ section.settings.heading_spacing }}px;
    --cp-para-space:    {{ section.settings.paragraph_spacing }}px;
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
    font-family: 'Work Sans', sans-serif;
  }

  /* ── Language visibility ── */
  #c-policy-{{ sid }} [data-lang] { display: none; }
  #c-policy-{{ sid }}[data-lang-active="en"] [data-lang="en"] { display: revert; }
  #c-policy-{{ sid }}[data-lang-active="fr"] [data-lang="fr"] { display: revert; }
  #c-policy-{{ sid }} h1[data-lang],
  #c-policy-{{ sid }} .c-policy__heading[data-lang] { display: none; }
  #c-policy-{{ sid }}[data-lang-active="en"] h1.c-policy__title[data-lang="en"],
  #c-policy-{{ sid }}[data-lang-active="en"] .c-policy__heading[data-lang="en"] { display: block; }
  #c-policy-{{ sid }}[data-lang-active="fr"] h1.c-policy__title[data-lang="fr"],
  #c-policy-{{ sid }}[data-lang-active="fr"] .c-policy__heading[data-lang="fr"] { display: block; }

  /* ── Inner wrapper ── */
  #c-policy-{{ sid }} .c-policy__inner {
    padding: var(--cp-pad-top-d) 32px var(--cp-pad-bottom-d);
  }
  #c-policy-{{ sid }} .c-policy__inner--contained {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Header ── */
#c-policy-{{ sid }} .c-policy__header {
  width: 100%;
  max-width: none;
  margin: 0 0 56px;
  text-align: left;
}
  #c-policy-{{ sid }} .c-policy__title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground));
    margin: 0 0 16px;
    text-wrap: pretty;
  }

  #c-policy-{{ sid }} .c-policy__date {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: rgba(var(--color-foreground), 0.55);
    margin: 0 0 28px;
    font-weight: 300;
  }

  /* ── Language switcher (the one feature that stays) ── */
  #c-policy-{{ sid }} .c-policy__lang-switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid rgba(var(--color-foreground), 0.14);
    margin-bottom: 32px;
  }
  #c-policy-{{ sid }} .c-policy__lang-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 18px;
    font-family: 'Work Sans', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.55);
    transition: background 0.2s ease, color 0.2s ease;
    border-radius: 2px;
  }
  #c-policy-{{ sid }} .c-policy__lang-btn[aria-pressed="true"] {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }
  @media (hover: hover) and (pointer: fine) {
    #c-policy-{{ sid }} .c-policy__lang-btn:not([aria-pressed="true"]):hover {
      color: rgb(var(--color-foreground));
    }
  }
  #c-policy-{{ sid }} .c-policy__lang-btn:focus-visible {
    outline: 2px solid rgba(var(--color-foreground), 0.6);
    outline-offset: 2px;
    z-index: 1;
    position: relative;
  }

  #c-policy-{{ sid }} .c-policy__intro p {
    font-family: 'Spectral', Georgia, serif;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(var(--color-foreground), 0.7);
    font-weight: 300;
    margin: 0 0 var(--cp-para-space);
  }
  #c-policy-{{ sid }} .c-policy__intro p:last-child { margin-bottom: 0; }
  #c-policy-{{ sid }} .c-policy__intro strong { font-weight: 500; }

  /* ── Content: single column, full width, comfortable reading measure ── */
 #c-policy-{{ sid }} .c-policy__content {
  width: 100%;
  max-width: none;
  margin: 0;
}

  #c-policy-{{ sid }} .c-policy__section {
     margin-bottom: 10px;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }
  #c-policy-{{ sid }} .c-policy__section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  #c-policy-{{ sid }} .c-policy__heading {
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 300;
    letter-spacing: -0.005em;
    color: rgb(var(--color-foreground));
    margin: 0 0 var(--cp-heading-space);
    text-wrap: pretty;
  }

  /* ── Rich text body ── */
  #c-policy-{{ sid }} .c-policy__rte {
    font-family: 'Spectral', Georgia, serif;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(var(--color-foreground), 0.7);
    font-weight: 300;
  }
  #c-policy-{{ sid }} .c-policy__rte p {
    margin: 0 0 var(--cp-para-space);
    text-wrap: pretty;
  }
  #c-policy-{{ sid }} .c-policy__rte p:last-child { margin-bottom: 0; }

  #c-policy-{{ sid }} .c-policy__rte h3 {
    font-family: 'Work Sans', sans-serif;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
    font-weight: 400;
    margin: 32px 0 14px;
  }
  #c-policy-{{ sid }} .c-policy__rte h3:first-child { margin-top: 0; }

  #c-policy-{{ sid }} .c-policy__rte ul,
  #c-policy-{{ sid }} .c-policy__rte ol {
    margin: 0 0 var(--cp-para-space);
    padding-left: 22px;
  }
  #c-policy-{{ sid }} .c-policy__rte ul ul,
  #c-policy-{{ sid }} .c-policy__rte ol ol,
  #c-policy-{{ sid }} .c-policy__rte ul ol,
  #c-policy-{{ sid }} .c-policy__rte ol ul {
    margin: 10px 0 0;
  }
  #c-policy-{{ sid }} .c-policy__rte li {
    margin-bottom: 12px;
    line-height: 1.65;
  }
  #c-policy-{{ sid }} .c-policy__rte li:last-child { margin-bottom: 0; }

  #c-policy-{{ sid }} .c-policy__rte strong { font-weight: 500; color: rgb(var(--color-foreground)); }
  #c-policy-{{ sid }} .c-policy__rte em { font-style: italic; }

  #c-policy-{{ sid }} .c-policy__rte a {
    color: rgb(var(--color-foreground));
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }
  #c-policy-{{ sid }} .c-policy__rte a:hover { opacity: 0.6; }
  #c-policy-{{ sid }} .c-policy__rte a:focus-visible {
    outline: 2px solid rgba(var(--color-foreground), 0.6);
    outline-offset: 2px;
  }

  #c-policy-{{ sid }} .c-policy__rte table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--cp-para-space);
    font-size: 13.5px;
  }
  #c-policy-{{ sid }} .c-policy__rte th,
  #c-policy-{{ sid }} .c-policy__rte td {
    border: 1px solid rgba(var(--color-foreground), 0.12);
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
  }
  #c-policy-{{ sid }} .c-policy__rte th {
    font-family: 'Work Sans', sans-serif;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 11px;
    color: rgb(var(--color-foreground));
    background: rgba(var(--color-foreground), 0.03);
  }

  /* ── TABLET ── */
  @media screen and (max-width: 989px) {
    #c-policy-{{ sid }} .c-policy__inner { padding: var(--cp-pad-top-d) 24px var(--cp-pad-bottom-d); }
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 749px) {
    #c-policy-{{ sid }} .c-policy__inner { padding: var(--cp-pad-top-m) 16px var(--cp-pad-bottom-m); }
    #c-policy-{{ sid }} .c-policy__lang-switch { width: 100%; }
    #c-policy-{{ sid }} .c-policy__lang-btn { flex: 1; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('c-policy-{{ sid }}');
  if (!root || root.dataset.cpInit) return;
  root.dataset.cpInit = '1';

  var storageKey = 'cast-policy-lang';
  var defaultLang = root.dataset.defaultLang || 'en';
  var hasFrench = root.dataset.hasFrench === 'true';

  /* ── Language: session-only (sessionStorage), URL param, keyboard nav ── */
  function getInitialLang() {
    if (!hasFrench) return 'en';
    var params = new URLSearchParams(window.location.search);
    var urlLang = params.get('lang');
    if (urlLang === 'en' || urlLang === 'fr') return urlLang;
    try {
      var stored = window.sessionStorage.getItem(storageKey);
      if (stored === 'en' || stored === 'fr') return stored;
    } catch (e) {}
    return defaultLang === 'fr' ? 'fr' : 'en';
  }

  var langBtns = Array.prototype.slice.call(root.querySelectorAll('[data-lang-btn]'));

  function setLang(lang, updateUrl) {
    root.setAttribute('data-lang-active', lang);
    langBtns.forEach(function (btn) {
      btn.setAttribute('aria-pressed', btn.dataset.langBtn === lang ? 'true' : 'false');
    });
    try { window.sessionStorage.setItem(storageKey, lang); } catch (e) {}

    if (updateUrl) {
      var url = new URL(window.location.href);
      url.searchParams.set('lang', lang);
      window.history.replaceState(null, '', url.toString());
    }
  }

  setLang(getInitialLang(), false);

  langBtns.forEach(function (btn, i) {
    btn.addEventListener('click', function () {
      setLang(btn.dataset.langBtn, true);
    });
    /* Arrow-key navigation between the two language buttons */
    btn.addEventListener('keydown', function (e) {
      var targetIndex = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') targetIndex = (i + 1) % langBtns.length;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') targetIndex = (i - 1 + langBtns.length) % langBtns.length;
      if (e.key === 'Home') targetIndex = 0;
      if (e.key === 'End') targetIndex = langBtns.length - 1;
      if (targetIndex !== null) {
        e.preventDefault();
        var target = langBtns[targetIndex];
        target.focus();
        setLang(target.dataset.langBtn, true);
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Terms & Conditions",
  "tag": "section",
  "class": "c-policy-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Language"
    },
    {
      "type": "checkbox",
      "id": "show_language_switcher",
      "label": "Show language switcher",
      "default": true,
      "info": "Automatically hidden if no block has French content filled in."
    },
    {
      "type": "select",
      "id": "default_language",
      "label": "Default language",
      "options": [
        {
          "value": "en",
          "label": "English"
        },
        {
          "value": "fr",
          "label": "Français"
        }
      ],
      "default": "en",
      "info": "Used only if the visitor has no saved preference and no ?lang= in the URL."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Section width",
      "options": [
        {
          "value": "full",
          "label": "Full width (matches site sections)"
        },
        {
          "value": "contained",
          "label": "Contained (max 1400px)"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 480,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below headings",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Space between paragraphs",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro / Header",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "English"
        },
        {
          "type": "text",
          "id": "title_en",
          "label": "Title (EN)",
          "default": "Terms & Conditions"
        },
        {
          "type": "text",
          "id": "effective_date_en",
          "label": "Effective date (EN)",
          "default": "Effective Date: June 1, 2026"
        },
        {
          "type": "richtext",
          "id": "intro_en",
          "label": "Intro text (EN)"
        },
        {
          "type": "header",
          "content": "Français"
        },
        {
          "type": "text",
          "id": "title_fr",
          "label": "Title (FR)"
        },
        {
          "type": "text",
          "id": "effective_date_fr",
          "label": "Effective date (FR)"
        },
        {
          "type": "richtext",
          "id": "intro_fr",
          "label": "Intro text (FR)"
        }
      ]
    },
    {
      "type": "section",
      "name": "Numbered section",
      "settings": [
        {
          "type": "header",
          "content": "English"
        },
        {
          "type": "text",
          "id": "heading_en",
          "label": "Heading (EN)"
        },
        {
          "type": "richtext",
          "id": "content_en",
          "label": "Content (EN)"
        },
        {
          "type": "header",
          "content": "Français"
        },
        {
          "type": "text",
          "id": "heading_fr",
          "label": "Heading (FR)",
          "info": "Leave blank if this document has no French version."
        },
        {
          "type": "richtext",
          "id": "content_fr",
          "label": "Content (FR)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Terms & Conditions",
      "category": "Legal",
      "blocks": [
        {
          "type": "intro",
          "settings": {
            "title_en": "Terms & Conditions",
            "effective_date_en": "Effective Date: June 1, 2026",
            "intro_en": "<p>These Terms &amp; Conditions (\"Terms\") govern your access to and use of the Cast website, products, and services (collectively, the \"Services\"). By accessing our website or purchasing our products, you agree to be bound by these Terms. If you do not agree, please do not use our Services.</p>",
            "title_fr": "Conditions générales",
            "effective_date_fr": "Date d'entrée en vigueur : 1 jun 2026",
            "intro_fr": "<p>Les présentes Conditions générales (« Conditions ») régissent votre accès au site Web de Cast ainsi que votre utilisation de celui-ci, de nos produits et de nos services (collectivement, les « Services »). En accédant à notre site Web ou en achetant nos produits, vous acceptez d'être lié par les présentes Conditions. Si vous n'y consentez pas, veuillez ne pas utiliser nos Services.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "heading_en": "1. Eligibility",
            "content_en": "<p>By using our Services, you confirm that you are the age of majority in your province, territory, state, or country of residence, or that you are using the Services with the consent and supervision of a parent or legal guardian.</p>",
            "heading_fr": "1. Admissibilité",
            "content_fr": "<p>En utilisant nos Services, vous confirmez avoir atteint l'âge de la majorité dans votre province, territoire, État ou pays de résidence, ou utiliser les Services avec le consentement et sous la supervision d'un parent ou d'un tuteur légal.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "heading_en": "2. Products",
            "content_en": "<p>We make every reasonable effort to accurately display our products, including colours, descriptions, ingredients, and pricing.</p><p>Because screen settings may vary, we cannot guarantee colours will appear exactly the same on every device.</p><p>Our products are intended for personal, non-commercial use unless otherwise agreed in writing.</p>",
            "heading_fr": "2. Produits",
            "content_fr": "<p>Nous déployons des efforts raisonnables afin de présenter avec exactitude nos produits, notamment leurs couleurs, descriptions, ingrédients et prix.</p><p>Les paramètres d'affichage pouvant varier d'un appareil à l'autre, nous ne pouvons garantir que les couleurs apparaîtront exactement de la même façon sur tous les écrans.</p><p>Nos produits sont destinés à un usage personnel et non commercial, sauf entente écrite contraire.</p>"
          }
        },
        {
          "type": "section",
